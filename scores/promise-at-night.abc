X:1
T:밤의 약속
T:(A Promise at Night)
R:Waltz
M:3/4
L:1/8
Q:1/4=96
%%score { 1 | 2 }
V:1 clef=treble name="Piano"
V:2 clef=bass
K:Gm
% 올드 유럽 영화음악 풍 오리지널(멜로디 창작): 반주 없는 고독한 독백으로 시작,
% 반음 이웃음의 그늘, 짧은 장조 위안, 숙명처럼 돌아오는 주제
% ===== Intro (1-4마디) : 홀로 — 반주 없는 독백 =====
[V:1] !p!"Gm""^홀로, 노래하듯"d2^c2d2 | "Gm"g2a2b2 | "D7"a2^f2g2 | "Gm"d4 z2 |
[V:2] z6 | z6 | z6 | z6 |
% ===== 기 · 주제 (5-12마디) : 낮은 왈츠가 받쳐준다 =====
[V:1] !mp!"Gm""^주제"d3 ^c2d | "Cm"e3 d2c | "D7"d3 c2A | "Gm"B4 G2 |
[V:2] G,2[B,D]2z2 | C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 |
[V:1] "Gm"d3 ^c2d | "Cm"e3 d2c | "D7"A3 ^F2A | "Gm"G4 z2 |
[V:2] G,2[B,D]2z2 | C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 |
% ===== 승 · 짧은 위안 (13-20마디) : Bb장조의 불빛 =====
[V:1] !mf!"Bb""^짧은 위안"f3 e2d | "Eb"g3 f2e | "F"a3 g2f | "Bb"B4 d2 |
[V:2] B,,2[D,F,]2z2 | E,2[G,B,]2z2 | F,2[A,C]2z2 | B,,2[D,F,]2z2 |
[V:1] "Cm"e3 f2g | "D7"^f3 g2a | "Gm"b3 a2g | "D7"a4 ^f2 |
[V:2] C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 | D,2[^F,C]2z2 |
% ===== 전 · 주제의 귀환 (21-28마디) : 숙명처럼 =====
[V:1] !mp!"Gm""^숙명처럼"d3 ^c2d | "Cm"e3 d2c | "D7"d3 c2A | "Gm"B4 G2 |
[V:2] G,2[B,D]2z2 | C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 |
[V:1] "Gm"d3 ^c2d | "Cm"e3 d2c | "D7"A3 ^F2A | "Gm"G4 z2 |
[V:2] G,2[B,D]2z2 | C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 |
% ===== 결 · Coda (29-32마디) : 어둠 속으로 =====
[V:1] !p!"Cm"e3 c2G | "D7"d3 ^c2A | !pp!"Gm""^rit."B2A2G2 | "Gm"H[GBd]6 |]
[V:2] C,2[E,G,]2z2 | D,2[^F,C]2z2 | G,2[B,D]2z2 | H[G,,D,G,]6 |]
